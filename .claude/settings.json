{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(git push:*)",
      "Bash(git commit --no-verify:*)",
      "Bash(git commit -n:*)",
      "Bash(npm publish:*)",
      "Bash(npm install -g:*)",
      "Bash(rm -rf:*)",
      "PowerShell(git push*)",
      "PowerShell(npm publish*)",
      "PowerShell(npm install -g*)",
      "PowerShell(Remove-Item -Recurse -Force*)",
      "Read(**/.env)",
      "Edit(**/.env)",
      "Read(keys.json)",
      "Edit(keys.json)"
    ],
    "allow": [
      "Bash(cd:*)",
      "Bash(bash scripts/harness.sh:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(npm test:*)",
      "Bash(npm run build:*)",
      "Bash(npm run test:coverage:*)",
      "Bash(npx ng test:*)",
      "Bash(npx ng build:*)",
      "Bash(npx ng version)",
      "Bash(npx tsc:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/deny-git-push.mjs\"",
            "timeout": 15,
            "statusMessage": "Checking for git push..."
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/harness.sh",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
